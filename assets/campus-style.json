{
  "version": 8,
  "name": "Campus UFCG (offline)",
  "metadata": {
    "maplibre:renderer": "vector",
    "note": "Estilo mínimo para o mapa offline do campus. A fonte 'campus' e a base de 'glyphs' são preenchidas pelo app em runtime."
  },
  "glyphs": "{fontstack}/{range}.pbf",
  "sources": {
    "campus": {
      "type": "vector"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#E3E3DF" }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "campus",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#E3E3DF",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "campus",
      "source-layer": "water",
      "paint": { "fill-color": "#D8DBD6" }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "campus",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#D6D6D1",
        "fill-outline-color": "#BDBDB6"
      }
    },
    {
      "id": "road",
      "type": "line",
      "source": "campus",
      "source-layer": "transportation",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#F4F4F1",
        "line-width": {
          "base": 1.4,
          "stops": [[12, 0.5], [14, 2], [18, 12]]
        }
      }
    },
    {
      "id": "place_label",
      "type": "symbol",
      "source": "campus",
      "source-layer": "place",
      "layout": {
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-size": {
          "base": 1.2,
          "stops": [[10, 11], [16, 16]]
        },
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#55554F",
        "text-halo-color": "#F4F4F1",
        "text-halo-width": 1.2
      }
    }
  ]
}
