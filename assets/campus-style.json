      }
    },
    {
      "id": "landuse_school",
      "type": "fill",
      "source": "campus",
      "source-layer": "landuse",
      "filter": [
        "in",
        "class",
        "school",
        "university",
        "college"
      ],
      "paint": {
        "fill-color": "#DCDCD6"
      }
    },
