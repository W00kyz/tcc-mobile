{
  "version": 8,
  "name": "Campus UFCG (offline)",
  "metadata": {
    "maplibre:renderer": "vector",
    "note": "Estilo do mapa offline do campus, nos cinzas do Cartão do Lote (spec §6.1): hierarquia de vias com contorno, nomes de ruas, pontos de interesse, áreas verdes e água. A fonte 'campus' e a base de 'glyphs' são preenchidas pelo app em runtime."
  },
  "glyphs": "{fontstack}/{range}.pbf",
  "sources": {
    "campus": {
      "type": "vector"
    }
  },
